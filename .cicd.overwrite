---

# Generic
generic:
  role: ansible-role-cicd
  role_short: cicd
  role_description: |
    Set of scripts to help setup CI/CD
  collections: []

# Molecule
molecule:
  requirements:
    roles_extra: []
  converge:
    vars:
      cicd_python_venv_install: true
      cicd_python_venv_list:
        - yq
        - e2j2

# Templates
ci_templates:
  ansible-lint:
    force: no
