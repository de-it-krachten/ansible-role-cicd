---

# Generic
generic:
  role: ansible-role-cicd
  role_short: cicd
  role_description: |
    Set of scripts to help setup CI/CD
  collections: []

# Supported platforms
platforms:
  sles15:
    supported: true
    ci: false
  sles16:
    supported: true
    ci: false
  opensuse15:
    supported: true
    ci: true
  opensuse16:
    supported: true
    ci: true
  debian11:
    supported: false
    ci: false

# Molecule
molecule:
  requirements:
    roles_extra: []

# Templates
ci_templates:
  ansible-lint:
    force: no
