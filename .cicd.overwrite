---

# Generic
generic:
  role: ansible-role-cicd
  role_short: cicd
  role_description: |
    Set of scripts to help setup CI/CD
  collections: []

# Supported platforms
platforms:
  debian11:
    supported: false
    ci: false

# Molecule
molecule:
  requirements:
    roles_extra: []

# Templates
ci_templates:
  ansible-lint:
    force: no
